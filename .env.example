# Copy to .env (gitignored). The Python API reads it at startup.
# Optional Vite proxy target when running this checkout on separate local ports.
# Pass in the shell launching Vite (default remains http://127.0.0.1:3001).
OFFICE_API_URL=http://127.0.0.1:3001
# SQLite database of the Python API.
AGENT_DATABASE_PATH=.data/agent.sqlite
# Leo's Python/Pydantic backend; mock works without credentials.
OFFICE_MODEL=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Read-only supplier + FINN discovery; never authorizes checkout or seller messages.
TAVILY_API_KEY=
FINN_DISCOVERY_ENABLED=true

# Official Oda MCP for food/drinks: connect an Oda account in the dashboard.
# Exact basket approval adds real products; delivery/payment remain on Oda.
# Live food interpretation uses OFFICE_MODEL=anthropic:<supported-model> and ANTHROPIC_API_KEY.
ODA_FOOD_ENABLED=true

# Notion tools for the agent are disabled for now (their tool definitions exceed the run token budget).
# Set to true to re-enable; the brain still reads config/brain/ or the last Notion snapshot.
NOTION_TOOLS_ENABLED=false
# Company brain on Notion (live mode only; mock uses config/brain/). Sign in with `npm run connect -- notion`.
# Root page whose child pages hold the procedures and the approval routing table.
NOTION_BRAIN_PAGE_ID=
# Optional: a Notion OAuth access token for the hosted MCP instead of the sign-in (integration tokens do not work).
NOTION_ACCESS_TOKEN=
# Office notebook (Pydantic AI Harness Memory) across tasks and restarts. Live mode only.
MEMORY_PATH=.data/memory.sqlite

# Voice input: ElevenLabs Scribe transcription (falls back to OpenAI with OPENAI_API_KEY).
ELEVENLABS_API_KEY=
TRANSCRIBE_MODEL=scribe_v2
# Speaker identification service (apps/voiceid, deployed on Modal). Identity is informational only.
VOICEID_URL=
VOICEID_TOKEN=

# Approval-request emails via AgentMail (notification only; approve/reject on the dashboard, replies do nothing).
# Off unless true AND a live OFFICE_MODEL; mock mode and tests never send. One email per task and exact proposal.
APPROVAL_EMAIL_ENABLED=false
AGENTMAIL_API_KEY=
# Sending inbox id (its address), e.g. office-assistant@agentmail.to.
AGENTMAIL_INBOX_ID=
# Approver name (as in config/brain/approval-routing.md) to address, comma-separated: Leo:leo@example.com,Teammate 2:t2@example.com
APPROVER_EMAILS=
# Link shown in the email.
DASHBOARD_URL=http://localhost:5173
