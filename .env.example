# Copy to .env (gitignored). Read by apps/agent at startup.
# "mock" = offline keyword model, no key needed. Live: anthropic:claude-sonnet-5-5 (needs ANTHROPIC_API_KEY).
OFFICE_MODEL=mock
ANTHROPIC_API_KEY=
# Voice (speech-to-text) — only needed with `uv sync --extra voice`.
OPENAI_API_KEY=
TRANSCRIBE_MODEL=gpt-4o-transcribe
DATABASE_PATH=.data/office.sqlite
