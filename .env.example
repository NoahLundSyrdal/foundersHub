# Root npm dev loads this file through the API; copy to .env.
PORT=3001
DATABASE_PATH=.data/office.sqlite
# mock works without credentials. anthropic requires an API key.
AGENT_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Supplier execution is simulation-only in this foundation.
SUPPLIER_PROVIDER=mock
