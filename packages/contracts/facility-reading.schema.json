{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "board_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "metric": {
      "type": "string",
      "enum": [
        "co2_ppm",
        "temperature_c",
        "humidity_pct",
        "stock_level",
        "bin_fill_pct",
        "obstruction_mm",
        "noise_level",
        "tilt_deg",
        "heartbeat"
      ]
    },
    "value": {
      "type": "number"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "simulation": {
      "type": "boolean"
    }
  },
  "required": [
    "event_id",
    "board_id",
    "metric",
    "value",
    "timestamp",
    "simulation"
  ],
  "additionalProperties": false
}
