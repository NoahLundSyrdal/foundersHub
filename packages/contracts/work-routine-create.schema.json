{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "event_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "local_time": {
      "type": "string",
      "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
    },
    "weekdays": {
      "default": [
        0,
        1,
        2,
        3,
        4,
        5,
        6
      ],
      "minItems": 1,
      "maxItems": 7,
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 6
      }
    },
    "starts_on": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "missed_policy": {
      "default": "latest",
      "type": "string",
      "enum": [
        "skip",
        "latest"
      ]
    },
    "overlap_policy": {
      "default": "link",
      "type": "string",
      "enum": [
        "link",
        "allow"
      ]
    },
    "work": {
      "type": "object",
      "properties": {
        "event_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "outcome": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "owner": {
          "default": "office-coordinator",
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "template_key": {
          "default": "custom",
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "context": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "requester_id": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "priority": {
          "default": "routine",
          "type": "string",
          "enum": [
            "routine",
            "urgent",
            "critical"
          ]
        },
        "due_at": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "next_review_at": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "escalation_owner": {
          "default": "office-coordinator",
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "simulation": {
          "default": true,
          "type": "boolean"
        },
        "steps": {
          "anyOf": [
            {
              "minItems": 1,
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "owner": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "depends_on": {
                    "default": [],
                    "maxItems": 30,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  },
                  "required_evidence": {
                    "default": [
                      "confirmation"
                    ],
                    "minItems": 1,
                    "maxItems": 20,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  },
                  "action_kind": {
                    "default": "human",
                    "type": "string",
                    "enum": [
                      "human",
                      "local",
                      "purchase",
                      "message",
                      "booking",
                      "access"
                    ]
                  },
                  "action_snapshot": {
                    "default": {},
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  },
                  "requires_approval": {
                    "default": false,
                    "type": "boolean"
                  }
                },
                "required": [
                  "id",
                  "title",
                  "owner",
                  "depends_on",
                  "required_evidence",
                  "action_kind",
                  "action_snapshot",
                  "requires_approval"
                ],
                "additionalProperties": false
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "event_key",
        "title",
        "outcome",
        "owner",
        "template_key",
        "context",
        "requester_id",
        "priority",
        "due_at",
        "next_review_at",
        "escalation_owner",
        "simulation"
      ],
      "additionalProperties": false
    },
    "enabled": {
      "default": true,
      "type": "boolean"
    },
    "review_interval_hours": {
      "default": 24,
      "type": "integer",
      "minimum": 1,
      "maximum": 168
    },
    "max_reminders": {
      "default": 2,
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    }
  },
  "required": [
    "event_key",
    "name",
    "timezone",
    "local_time",
    "weekdays",
    "starts_on",
    "missed_policy",
    "overlap_policy",
    "work",
    "enabled",
    "review_interval_hours",
    "max_reminders"
  ],
  "additionalProperties": false
}
