{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "board_id": {
      "default": "office",
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": [
    "conversation_id",
    "event_id",
    "text",
    "board_id"
  ],
  "additionalProperties": false
}
