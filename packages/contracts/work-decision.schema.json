{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "event_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "expected_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "step_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "approve": {
      "type": "boolean"
    },
    "proposal_fingerprint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": [
    "event_key",
    "expected_version",
    "step_id",
    "approve",
    "proposal_fingerprint"
  ],
  "additionalProperties": false
}
