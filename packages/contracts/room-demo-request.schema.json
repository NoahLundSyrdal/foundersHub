{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "board_id": {
      "type": "string",
      "enum": [
        "kitchen",
        "bathroom",
        "printer"
      ]
    },
    "action": {
      "type": "string",
      "enum": [
        "seed",
        "clear"
      ]
    }
  },
  "required": [
    "board_id",
    "action"
  ],
  "additionalProperties": false
}
