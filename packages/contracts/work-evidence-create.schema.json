{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "event_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "expected_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "step_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "recorded_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": [
    "event_key",
    "expected_version",
    "step_id",
    "kind",
    "summary",
    "source",
    "recorded_by"
  ],
  "additionalProperties": false
}
